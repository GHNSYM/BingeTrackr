# ─── Supabase ─────────────────────────────────────────────────────────────
# Create a project at https://supabase.com, then grab these from
# Project Settings → API. The URL and anon key are safe to expose (public);
# the service role key is server-only — never import it into client code.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-url.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── TMDB ────────────────────────────────────────────────────────────────
# Free API key from https://www.themoviedb.org/settings/api
# Attribution is required — put "Powered by TMDB" in the footer.
TMDB_API_KEY=

# ─── AniList ─────────────────────────────────────────────────────────────
# AniList GraphQL API needs no key for public queries. Nothing to set here.

# ─── Cron protection ─────────────────────────────────────────────────────
# Any random string. Vercel Cron sends this as Authorization: Bearer <secret>.
CRON_SECRET=

# ─── App URL ─────────────────────────────────────────────────────────────
# Last-resort fallback ONLY, for building auth email links (signup
# confirmation, password reset) — see getAppOrigin() in lib/auth/actions.ts.
# That function derives the real origin from the incoming request's
# x-forwarded-host/-proto headers (correct on Vercel for prod AND every
# preview deployment automatically), so this value is never actually used
# there in practice. It's genuinely unused elsewhere: OG images and share
# links both derive their origin dynamically already (window.location.origin
# / Next's OG image generation), not from this var — don't reintroduce a
# static-URL dependency on either of those.
NEXT_PUBLIC_APP_URL=http://localhost:3000
